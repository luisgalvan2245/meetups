    "tsoa": "^6.6.0",
    "winston": "^3.17.0",
    "dotenv": "^16.5.0",
    "http-status": "^2.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "@types/uuid": "10.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "typescript": "^5.4.2",
    "vitest": "^3.1.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/swagger-ui-express": "^4.1.6",
    "tsx": "^4.7.1",
